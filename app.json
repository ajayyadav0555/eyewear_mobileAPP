{
  "expo": {
    "name": "eyewear",
    "slug": "eyewear",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/appicon.png",
    "scheme": "eyewear",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/appicon.png",
      "bundleIdentifier": "com.ajayyadav055.eyewear"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/appicon.png",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ajayyadav055.eyewear"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/appicon.png",
            "imageWidth": 76
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b87005d-1ac4-4520-a26d-94f1d0e69fab"
      }
    }
  }
}
